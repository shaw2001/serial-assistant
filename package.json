{
  "name": "serial-assistant",
  "productName": "SerialAssistant",
  "version": "0.1.0",
  "description": "离线多串口调试助手，支持文本、HEX、快捷指令和无损日志",
  "main": "src/main/main.cjs",
  "author": "shaw2001",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "npm run build && electron .",
    "build": "node scripts/build.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:pty": "python3 tests/pty_integration.py",
    "dist:win": "npm run build && electron-builder --win nsis zip --x64 --publish never",
    "dist:win:zip": "npm run build && electron-builder --win zip --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux tar.gz --x64 --publish never",
    "checksums": "node scripts/checksums.cjs"
  },
  "dependencies": {
    "iconv-lite": "0.7.2",
    "serialport": "13.0.0"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.27.4",
    "jsdom": "26.1.0"
  },
  "build": {
    "appId": "io.github.shaw2001.serialassistant",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "src/main/**/*",
      "dist/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true,
      "artifactName": "SerialAssistant-${version}-win-${arch}.${ext}",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "串口助手",
      "artifactName": "SerialAssistant-Setup-${version}-win-${arch}.${ext}"
    },
    "linux": {
      "target": "tar.gz",
      "category": "Development"
    }
  }
}
